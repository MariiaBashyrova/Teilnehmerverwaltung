<Window x:Class="Teilnehmerverwaltung.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Teilnehmerverwaltung"
        xmlns:vm="clr-namespace:Teilnehmerverwaltung.ViewModels"

        mc:Ignorable="d"
        Title="Teilnehmer Verwaltung" Height="450" Width="600">
    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid  Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Teilnehmerliste"/>


            <!-- Nachname -->
            <TextBlock Grid.Row="1" Grid.Column="0"  Text="Suche: "  />

            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Suche}" />
        </Grid>
        <DockPanel Grid.Row="1">
        <TextBlock DockPanel.Dock="Top" Text="NeuStart IT-Akademie : Teilnehmerverwaltung"/>
            
                    <DataGrid
                ItemsSource="{Binding Teilnehmers}"
                SelectedItem="{Binding SelectedTeilnehmer}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                SelectionMode="Single"
                CanUserAddRows="False">

                <DataGrid.Columns>
                    <DataGridTextColumn
            Header="TN-Nr."
            Binding="{Binding TeilnehmerNr}" />

                    <DataGridTextColumn
            Header="Name"
            Binding="{Binding VollName}" />

                    <DataGridTextColumn
            Header="Geburtsdatum"
            Binding="{Binding Geburtsdatum, StringFormat={}{0:dd.MM.yyyy}}" />

                    <DataGridTextColumn
            Header="E-Mail"
            Binding="{Binding EMail}" />

                    <DataGridTextColumn
            Header="Status"
            Binding="{Binding Status}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Gray"/>
        <DockPanel Grid.Row="3" IsEnabled="{Binding FormularAktiv}">
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Vorname -->
                <TextBlock Grid.Row="0" Grid.Column="0"
               Text="Vorname *"/>

                <TextBox Grid.Row="0" Grid.Column="1"
             Text="{Binding Vorname}"
             />

                <!-- Nachname -->
                <TextBlock Grid.Row="1" Grid.Column="0"
               Text="Nachname *"
               />

                <TextBox Grid.Row="1" Grid.Column="1"
             Text="{Binding Nachname}"
             />

                <!-- E-Mail -->
                <TextBlock Grid.Row="2" Grid.Column="0"
               Text="E-Mail"
               />

                <TextBox Grid.Row="2" Grid.Column="1"
             Text="{Binding EMail}"
            />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Geb. Datum"/>
                <DatePicker  Grid.Row="3" Grid.Column="1" SelectedDate="{Binding Geburtsdatum, Mode=TwoWay}"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Umschulung *"/>
                <ComboBox Grid.Row ="4" Grid.Column="2" DisplayMemberPath="KursNr" ItemsSource="{Binding Umschulungen}" SelectedItem="{Binding Umschulung, Mode=TwoWay}" />
                    
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Kostenträger *"/>
                <ComboBox Grid.Row ="5" Grid.Column="2" DisplayMemberPath="Bezeichnung" ItemsSource="{Binding Kostentraegers}" SelectedItem="{Binding Kostentraeger, Mode=TwoWay}" />
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Status"/>
                <ComboBox Grid.Row ="6" Grid.Column="2" ItemsSource="{Binding TeilnehmerStatusWerte}" SelectedItem="{Binding Status, Mode=TwoWay}" />
                <TextBlock Grid.Row="7" Grid.Column="0" Text="* Pflichtfelder"/>
            </Grid>
           
        </DockPanel>
        <StackPanel  Grid.Row="4" Orientation="Horizontal">
            <Button Content="Neu" Command="{Binding NeuCommand}" />
            <Button Content="Speichern" Command="{Binding SpeichernCommand}" />
            <Button Content="Löschen" Command="{Binding LoeschenCommand}" />
        </StackPanel>
    </Grid>
</Window>
